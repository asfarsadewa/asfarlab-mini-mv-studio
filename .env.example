# Copy this file to .env and fill in the values. Git ignores .env.
# The tools read the environment, so load it first. In bash: set -a; source .env; set +a
GEMINI_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
FAL_KEY=

# Optional. Set these if tools/doctor.py cannot find the program or the fonts.
# BLENDER=/path/to/blender
# FONT_DIR=/path/to/fonts
